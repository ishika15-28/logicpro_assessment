# Time Complexity: O(n) average, Space Complexity: O(n).

def frequency_count(arr):

    frequency = {}

    for num in arr:

        if num in frequency:
            frequency[num] += 1
        else:
            frequency[num] = 1

    return frequency


arr = [4, 2, 4, 3, 2, 4, 1]

result = frequency_count(arr)

print("Frequency:", result)

most_frequent = max(result, key=result.get)

print("Most Frequent Number:", most_frequent)
print("Frequency:", result[most_frequent])

