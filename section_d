# Two Pointers for sorted array

def two_sum(arr, target):

    left = 0
    right = len(arr) - 1

    while left < right:

        total = arr[left] + arr[right]

        if total == target:
            return arr[left], arr[right]

        elif total < target:
            left += 1

        else:
            right -= 1

    return None


arr = [1, 2, 4, 6, 8, 9]

print("Sorted Array Pair:", two_sum(arr, 10))


# Hashing for unsorted array

def pair_sum_unsorted(arr, target):

    seen = set()

    for num in arr:

        complement = target - num

        if complement in seen:
            return complement, num

        seen.add(num)

    return None


arr2 = [4, 7, 2, 8, 5]

print("Unsorted Array Pair:", pair_sum_unsorted(arr2, 10))

