def maximum_sum(arr, k):

    window_sum = sum(arr[:k])
    max_sum = window_sum

    for i in range(k, len(arr)):

        window_sum += arr[i]
        window_sum -= arr[i-k]

        max_sum = max(max_sum, window_sum)

    return max_sum


arr = [3, 1, 4, 2, 5, 1, 6]

print("Maximum Contiguous Sum:", maximum_sum(arr, 3))