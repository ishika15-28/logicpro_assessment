#Identify the pattern
#Calculate the difference between consecutive numbers:
#4 - 2 = 2 ;6 - 4 = 2;8 - 6 = 2; 10 - 8 = 2;12 - 10 = 2
#The common difference is 2.

#Therefore, it is an Arithmetic Progression



#code:
def check_constant_difference(arr):

    if len(arr) <= 2:
        return True

    difference = arr[1] - arr[0]

    for i in range(1, len(arr) - 1):
        if arr[i + 1] - arr[i] != difference:
            return False

    return True

arr = [2, 4, 6, 8, 10, 12]

print(check_constant_difference(arr))


#The given sequence is an Arithmetic Progression (AP).
#4 - 2 = 2;6 - 4 = 2;8 - 6 = 2;10 - 8 = 2;12 - 10 = 2
#The common difference is 2, so the function returns True.
#- Time Complexity: O(n)
#- Space Complexity: O(1)



